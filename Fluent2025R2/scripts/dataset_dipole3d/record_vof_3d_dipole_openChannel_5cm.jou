(define pointindex 0)
(define z_max 15)
(define z_step 2.5)
; XY-plan: 11*11=121 points
(do ((y -5 (+ y 1)))
    ((> y 5))
  (do ((x 0 (+ x 1)))
      ((> x 10))
    (set! pointindex (+ pointindex 1))
    (cx-gui-do cx-set-text-entry "Point Surface*Table1*TextEntry1(Name)"  (string-append "point" (number->string pointindex)))
    ;; Convert cm to meter
    (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry1(x)" (list (/ x 100.0)))
    (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry2(y)" (list (/ y 100.0)))
    (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry3(z)" (list 0))
    (cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton1(OK)")
  )
)

; XZ-plan: 11*5=55 points
(do ((z z_step (+ z z_step)))
    ((> z z_max))
  (do ((x 0 (+ x 1)))
      ((> x 10))
    (set! pointindex (+ pointindex 1))
    (cx-gui-do cx-set-text-entry "Point Surface*Table1*TextEntry1(Name)"  (string-append "point" (number->string pointindex)))
    ;; Convert cm to meter
    (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry1(x)" (list (/ x 100.0)))
    (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry2(y)" (list 0))
    (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry3(z)" (list (/ z 100.0)))
    (cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton1(OK)")
  )
)

; YZ-plan: 10*5=50 points
(do ((z z_step (+ z z_step)))
    ((> z z_max))
  (do ((y -5 (+ y 1)))
      ((> y 5))
      ; if y==0; continue
      (if (not (= y 0))
          (begin
            (set! pointindex (+ pointindex 1))
            (cx-gui-do cx-set-text-entry "Point Surface*Table1*TextEntry1(Name)"  (string-append "point" (number->string pointindex)))
            ;; Convert cm to meter
            (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry1(x)" (list 0))
            (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry2(y)" (list (/ y 100.0)))
            (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry3(z)" (list (/ z 100.0)))
            (cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton1(OK)")
          )
      )
  )
)

(cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton2(Cancel)")
;=========================================================== Points Define End ==============================================================



