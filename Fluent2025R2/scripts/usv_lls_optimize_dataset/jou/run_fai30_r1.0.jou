; loop create points
(for-each
 (lambda (xyz)
   (set! pointindex (+ pointindex 1))
   (let ((x (car xyz))
         (y (cadr xyz))
         (z (caddr xyz)))
     ; set name: point1,point2 ... point40
     (cx-gui-do cx-set-text-entry "Point Surface*Table1*TextEntry1(Name)"
                (string-append "point" (number->string pointindex)))
     ; coordinates
     (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry1(x)" (list x))
     (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry2(y)" (list y))
     (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame5(Coordinates)*Table1*RealEntry3(z)" (list z))
     ; create
     (cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton1(OK)")
   )
 )
 point-list
)

(cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton2(Cancel)")
;=========================================================== Points Define End ==============================================================



