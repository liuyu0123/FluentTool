; Create points
;(define (TorpedoX i) (- (* 0.01 (- i 1)) 0.1))
(define (TorpedoX i) (* 2 (* 0.001 i)))

(define (TorpedoY i) 
  ( + 45 ( * 45 (expt (- 1 (expt (- 1 (/ i 90)) 2)) 0.5) ) )   )

(define (Torpedo i) 0.0001)


(cx-gui-do cx-activate-item "Ribbon*Frame1*Frame6(Results)*Table1*Table3(Surface)*PushButton1(Create)")
(cx-gui-do cx-activate-item "MenuBar*PopupMenuCreate*Point...")

(define (SetPointsUp n)
  (let loop ((i 1))
    (if (<= i n)
        (begin
          ;(define xlabelpoint (- (* 0.01 (- i 1)) 0.1))
          ;(+ xlabelpoint 0)
          (cx-gui-do cx-set-text-entry "Point Surface*Table1*TextEntry1(Name)"  (string-append "point" (number->string i)))
          (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry1(x)" (list (TorpedoX i)))
          (cx-gui-do cx-activate-item "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry1(x)")
          ;(cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)" (list (TorpedoY (+ (TorpedoX i) 0.1))))
          (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)" (list (+ (* (TorpedoY (* (TorpedoX i) 1000)) 0.001) 0.0001)))
          ;(cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)" (list (+ (Torpedo (TorpedoX i)) 0.1001)))
          (cx-gui-do cx-activate-item "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)")
          (cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton1(OK)")
          (loop (+ i 1))))))

(define (SetPointsDown n)
  (let loop ((i 1))
    (if (<= i n)
        (begin
          ;(define xlabelpoint (- (* 0.01 (- i 1)) 0.1))
          (cx-gui-do cx-set-text-entry "Point Surface*Table1*TextEntry1(Name)" (string-append "point" (number->string (+ i 45))))
          (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry1(x)" (list (TorpedoX i)))
          (cx-gui-do cx-activate-item "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry1(x)")
          (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)" (list (- 0 (+ (* (TorpedoY (* (TorpedoX i) 1000)) 0.001) 0.0001))))
          (cx-gui-do cx-activate-item "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)")
          (cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton1(OK)")
          (loop (+ i 1))))))

(define (SetPointsSide n)
  (let loop ((i 1))
    (if (<= i n)
        (begin
          ;(define xlabelpoint (- (* 0.01 (- i 1)) 0.1))
          (cx-gui-do cx-set-text-entry "Point Surface*Table1*TextEntry1(Name)" (string-append "point" (number->string (+ i 90))))
          (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry1(x)" (list (- 0 0.0001)))
          (cx-gui-do cx-activate-item "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry1(x)")
          (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)" (list (* (- (* 2 i) 45) 0.001)))
          (cx-gui-do cx-activate-item "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)")
          (cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton1(OK)")
          (loop (+ i 1))))))

(define (SetJointPoint i)
  (begin 
    (cx-gui-do cx-set-text-entry "Point Surface*Table1*TextEntry1(Name)" (string-append "point" (number->string i)))
    (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry1(x)" (list 0.0005))
    (cx-gui-do cx-activate-item "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry1(x)")
    (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)" (list (+ (* (TorpedoY (* 0.0005 1000)) 0.001) 0.0001)))
    (cx-gui-do cx-activate-item "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)")
    (cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton1(OK)")

    (cx-gui-do cx-set-text-entry "Point Surface*Table1*TextEntry1(Name)" (string-append "point" (number->string (+ i 1))))
    (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry1(x)" (list 0.0005))
    (cx-gui-do cx-activate-item "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry1(x)")
    (cx-gui-do cx-set-real-entry-list "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)" (list (- 0 (+ (* (TorpedoY (* 0.0005 1000)) 0.001) 0.0001))))
    (cx-gui-do cx-activate-item "Point Surface*Table1*Frame3(Coordinates)*Table1*RealEntry2(y)")
    (cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton1(OK)")))


(SetPointsUp 45)
(SetPointsDown 45)
(SetPointsSide 45)
(SetJointPoint 136)

(cx-gui-do cx-activate-item "Point Surface*PanelButtons*PushButton2(Cancel)")



